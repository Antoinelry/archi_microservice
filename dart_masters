<!DOCTYPE html>
<html lang="fr" class="h-full bg-slate-950 text-slate-100 select-none">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="DartMaster">
  <title>Dart Master Pro - Compteur & Progression iPad</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Chakra+Petch:ital,wght@0,400;0,600;0,700;1,700&family=Inter:wght@400;600;800&display=swap');
    
    body {
      font-family: 'Inter', sans-serif;
      touch-action: manipulation;
      -webkit-tap-highlight-color: transparent;
    }
    
    .font-score {
      font-family: 'Chakra Petch', monospace, sans-serif;
    }

    /* Glows & Neon effects */
    .glow-amber {
      box-shadow: 0 0 25px rgba(245, 158, 11, 0.35);
    }
    .glow-emerald {
      box-shadow: 0 0 25px rgba(16, 185, 129, 0.4);
    }
    .text-glow {
      text-shadow: 0 0 16px rgba(245, 158, 11, 0.6);
    }

    /* Custom Touch Button click feedback */
    .btn-touch:active {
      transform: scale(0.96);
    }

    /* Hide scrollbars */
    .no-scrollbar::-webkit-scrollbar {
      display: none;
    }
    .no-scrollbar {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }
  </style>
</head>
<body class="h-full flex flex-col overflow-hidden bg-gradient-to-b from-slate-950 via-slate-900 to-zinc-950">

  <!-- TOP BAR / HEADER -->
  <header class="flex-none px-4 py-3 bg-slate-900/90 border-b border-slate-800 flex items-center justify-between backdrop-blur-md z-30">
    <div class="flex items-center space-x-3">
      <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-amber-500 to-rose-500 flex items-center justify-center shadow-lg shadow-amber-500/20">
        <i class="fa-solid fa-bullseye text-white text-xl"></i>
      </div>
      <div>
        <h1 class="text-xl font-extrabold tracking-wide text-white flex items-center gap-2">
          DART<span class="text-amber-400">MASTER</span>
          <span class="text-xs px-2 py-0.5 rounded-full bg-amber-500/20 text-amber-300 font-semibold border border-amber-500/30 uppercase tracking-wider" id="gameModeBadge">X01</span>
        </h1>
        <p class="text-xs text-slate-400 font-medium" id="gameSubtitle">501 - Double Out</p>
      </div>
    </div>

    <!-- Actions & Modals -->
    <div class="flex items-center space-x-2">
      <!-- Progression & Stats Button -->
      <button onclick="openHistoryModal()" class="h-11 px-3.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-amber-400 border border-amber-500/30 flex items-center gap-2 transition font-semibold shadow">
        <i class="fa-solid fa-chart-line text-lg"></i>
        <span class="hidden sm:inline text-sm font-bold text-slate-200">Progression</span>
      </button>

      <button onclick="toggleAudio()" id="btnAudio" class="w-11 h-11 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 flex items-center justify-center border border-slate-700/60 transition shadow">
        <i class="fa-solid fa-volume-high text-lg"></i>
      </button>

      <button onclick="undoLastAction()" class="h-11 px-3.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 flex items-center gap-2 border border-slate-700/60 transition font-semibold shadow">
        <i class="fa-solid fa-rotate-left text-amber-400"></i>
        <span class="hidden sm:inline text-sm">Annuler</span>
      </button>

      <button onclick="openNewGameModal()" class="h-11 px-4 rounded-xl bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-400 hover:to-amber-500 text-slate-950 font-bold flex items-center gap-2 shadow-lg shadow-amber-500/25 transition">
        <i class="fa-solid fa-sliders"></i>
        <span class="text-sm">Partie</span>
      </button>
    </div>
  </header>

  <!-- MAIN VIEWPORT -->
  <main class="flex-1 flex flex-col md:flex-row overflow-hidden p-2 sm:p-3 gap-2 sm:gap-3">
    
    <!-- LEFT PANEL: SCOREBOARD & STATS (VISIBLE FROM AFAR) -->
    <section class="flex-1 flex flex-col bg-slate-900/60 rounded-2xl border border-slate-800/80 p-3 sm:p-4 overflow-hidden relative backdrop-blur-sm shadow-xl">
      
      <!-- Players Carousel / Grid -->
      <div id="playersContainer" class="flex-1 flex gap-3 overflow-x-auto no-scrollbar items-stretch pb-2">
        <!-- Rendered via JS -->
      </div>

      <!-- Checkout Banner (X01 only) -->
      <div id="checkoutCard" class="mt-2 py-2.5 px-4 bg-emerald-950/40 border border-emerald-500/30 rounded-xl flex items-center justify-between shadow-lg">
        <div class="flex items-center gap-2.5">
          <span class="text-xs font-bold uppercase tracking-wider text-emerald-400 flex items-center gap-1">
            <i class="fa-solid fa-route"></i> Finition conseillée:
          </span>
          <span id="checkoutSuggestion" class="font-score text-lg sm:text-xl font-bold text-emerald-300 tracking-wider">
            T20, T20, Bull (170)
          </span>
        </div>
        <span id="checkoutModeBadge" class="text-xs text-emerald-400/80 hidden sm:inline font-medium">Double Out</span>
      </div>

      <!-- Live Leg History / Mini-feed -->
      <div class="mt-2.5 flex items-center justify-between text-xs text-slate-400 px-2">
        <div class="flex items-center gap-3">
          <span id="turnCounter" class="font-semibold text-slate-300">Volée #1</span>
          <span class="text-slate-600">•</span>
          <span id="lastDartsSummary">Dernière volée: <b class="text-slate-200">-</b></span>
        </div>
        <div class="flex items-center gap-2">
          <span>Match: <span id="legScoreInfo" class="font-bold text-amber-400">1st Leg</span></span>
        </div>
      </div>
    </section>

    <!-- RIGHT PANEL: INTERACTIVE TACTILE KEYPAD (OPTIMIZED FOR IPAD) -->
    <section class="w-full md:w-[420px] lg:w-[460px] flex-none flex flex-col bg-slate-900/90 rounded-2xl border border-slate-800 p-3 sm:p-4 shadow-2xl backdrop-blur-md">
      
      <!-- Input Mode Switcher -->
      <div class="flex bg-slate-950/80 p-1 rounded-xl mb-3 border border-slate-800 text-xs font-bold">
        <button id="tabDartByDart" onclick="setInputMode('dartByDart')" class="flex-1 py-2 rounded-lg transition text-slate-300 hover:text-white flex items-center justify-center gap-2">
          <i class="fa-solid fa-bullseye"></i> Flèche par Flèche
        </button>
        <button id="tabTurnScore" onclick="setInputMode('turnScore')" class="flex-1 py-2 rounded-lg transition text-slate-300 hover:text-white flex items-center justify-center gap-2">
          <i class="fa-solid fa-calculator"></i> Score Direct
        </button>
      </div>

      <!-- MODE 1: DART BY DART INPUT -->
      <div id="panelDartByDart" class="flex-1 flex flex-col">
        <!-- 3 Darts Current Turn Indicator -->
        <div class="grid grid-cols-3 gap-2 mb-3">
          <div id="dartSlot0" class="bg-slate-950 border border-slate-800 rounded-xl p-2 text-center transition">
            <span class="text-[10px] uppercase font-bold text-slate-500 block">Flèche 1</span>
            <span class="font-score text-xl font-bold text-amber-400 slot-text">-</span>
          </div>
          <div id="dartSlot1" class="bg-slate-950 border border-slate-800 rounded-xl p-2 text-center transition">
            <span class="text-[10px] uppercase font-bold text-slate-500 block">Flèche 2</span>
            <span class="font-score text-xl font-bold text-amber-400 slot-text">-</span>
          </div>
          <div id="dartSlot2" class="bg-slate-950 border border-slate-800 rounded-xl p-2 text-center transition">
            <span class="text-[10px] uppercase font-bold text-slate-500 block">Flèche 3</span>
            <span class="font-score text-xl font-bold text-amber-400 slot-text">-</span>
          </div>
        </div>

        <!-- Multipliers: Single / Double / Triple -->
        <div class="grid grid-cols-3 gap-2 mb-2.5">
          <button onclick="setMultiplier(1)" id="btnMult1" class="btn-touch py-3 rounded-xl font-bold text-sm bg-amber-500 text-slate-950 shadow-md">SIMPLE</button>
          <button onclick="setMultiplier(2)" id="btnMult2" class="btn-touch py-3 rounded-xl font-bold text-sm bg-slate-800 text-emerald-400 border border-slate-700/70">DOUBLE</button>
          <button onclick="setMultiplier(3)" id="btnMult3" class="btn-touch py-3 rounded-xl font-bold text-sm bg-slate-800 text-rose-400 border border-slate-700/70">TRIPLE</button>
        </div>

        <!-- Numbers Grid (1 to 20 + Specials) -->
        <div class="grid grid-cols-5 gap-1.5 sm:gap-2 flex-1">
          <button onclick="handleDartValue(20)" class="btn-touch bg-slate-800 hover:bg-slate-700 text-white font-score text-xl font-bold rounded-xl flex items-center justify-center border border-slate-700/40">20</button>
          <button onclick="handleDartValue(1)" class="btn-touch bg-slate-800 hover:bg-slate-700 text-white font-score text-xl font-bold rounded-xl flex items-center justify-center border border-slate-700/40">1</button>
          <button onclick="handleDartValue(18)" class="btn-touch bg-slate-800 hover:bg-slate-700 text-white font-score text-xl font-bold rounded-xl flex items-center justify-center border border-slate-700/40">18</button>
          <button onclick="handleDartValue(4)" class="btn-touch bg-slate-800 hover:bg-slate-700 text-white font-score text-xl font-bold rounded-xl flex items-center justify-center border border-slate-700/40">4</button>
          <button onclick="handleDartValue(13)" class="btn-touch bg-slate-800 hover:bg-slate-700 text-white font-score text-xl font-bold rounded-xl flex items-center justify-center border border-slate-700/40">13</button>

          <button onclick="handleDartValue(6)" class="btn-touch bg-slate-800 hover:bg-slate-700 text-white font-score text-xl font-bold rounded-xl flex items-center justify-center border border-slate-700/40">6</button>
          <button onclick="handleDartValue(10)" class="btn-touch bg-slate-800 hover:bg-slate-700 text-white font-score text-xl font-bold rounded-xl flex items-center justify-center border border-slate-700/40">10</button>
          <button onclick="handleDartValue(15)" class="btn-touch bg-slate-800 hover:bg-slate-700 text-white font-score text-xl font-bold rounded-xl flex items-center justify-center border border-slate-700/40">15</button>
          <button onclick="handleDartValue(2)" class="btn-touch bg-slate-800 hover:bg-slate-700 text-white font-score text-xl font-bold rounded-xl flex items-center justify-center border border-slate-700/40">2</button>
          <button onclick="handleDartValue(17)" class="btn-touch bg-slate-800 hover:bg-slate-700 text-white font-score text-xl font-bold rounded-xl flex items-center justify-center border border-slate-700/40">17</button>

          <button onclick="handleDartValue(3)" class="btn-touch bg-slate-800 hover:bg-slate-700 text-white font-score text-xl font-bold rounded-xl flex items-center justify-center border border-slate-700/40">3</button>
          <button onclick="handleDartValue(19)" class="btn-touch bg-slate-800 hover:bg-slate-700 text-white font-score text-xl font-bold rounded-xl flex items-center justify-center border border-slate-700/40">19</button>
          <button onclick="handleDartValue(7)" class="btn-touch bg-slate-800 hover:bg-slate-700 text-white font-score text-xl font-bold rounded-xl flex items-center justify-center border border-slate-700/40">7</button>
          <button onclick="handleDartValue(16)" class="btn-touch bg-slate-800 hover:bg-slate-700 text-white font-score text-xl font-bold rounded-xl flex items-center justify-center border border-slate-700/40">16</button>
          <button onclick="handleDartValue(8)" class="btn-touch bg-slate-800 hover:bg-slate-700 text-white font-score text-xl font-bold rounded-xl flex items-center justify-center border border-slate-700/40">8</button>

          <button onclick="handleDartValue(11)" class="btn-touch bg-slate-800 hover:bg-slate-700 text-white font-score text-xl font-bold rounded-xl flex items-center justify-center border border-slate-700/40">11</button>
          <button onclick="handleDartValue(14)" class="btn-touch bg-slate-800 hover:bg-slate-700 text-white font-score text-xl font-bold rounded-xl flex items-center justify-center border border-slate-700/40">14</button>
          <button onclick="handleDartValue(9)" class="btn-touch bg-slate-800 hover:bg-slate-700 text-white font-score text-xl font-bold rounded-xl flex items-center justify-center border border-slate-700/40">9</button>
          <button onclick="handleDartValue(12)" class="btn-touch bg-slate-800 hover:bg-slate-700 text-white font-score text-xl font-bold rounded-xl flex items-center justify-center border border-slate-700/40">12</button>
          <button onclick="handleDartValue(5)" class="btn-touch bg-slate-800 hover:bg-slate-700 text-white font-score text-xl font-bold rounded-xl flex items-center justify-center border border-slate-700/40">5</button>
        </div>

        <!-- Bull / Bullseye / Miss Bar -->
        <div class="grid grid-cols-3 gap-2 mt-2">
          <button onclick="handleDartSpecial('miss')" class="btn-touch py-3 rounded-xl font-bold text-sm bg-slate-800/90 text-rose-300 border border-rose-900/40">
            <i class="fa-solid fa-xmark mr-1"></i> MANQUÉ (0)
          </button>
          <button onclick="handleDartSpecial('bull')" class="btn-touch py-3 rounded-xl font-bold text-sm bg-emerald-950/80 text-emerald-300 border border-emerald-600/50">
            BULL (25)
          </button>
          <button onclick="handleDartSpecial('doubleBull')" class="btn-touch py-3 rounded-xl font-bold text-sm bg-rose-950/80 text-rose-300 border border-rose-600/50">
            D-BULL (50)
          </button>
        </div>

        <!-- Confirm Turn Button -->
        <button onclick="confirmTurnDarts()" class="btn-touch mt-2.5 w-full py-3.5 bg-gradient-to-r from-emerald-500 to-teal-500 text-slate-950 rounded-xl font-extrabold text-base flex items-center justify-center gap-2 shadow-lg shadow-emerald-500/25">
          <span>VALIDER LA VOLÉE</span>
          <i class="fa-solid fa-arrow-right"></i>
        </button>
      </div>

      <!-- MODE 2: TOTAL TURN SCORE INPUT (NUMPAD + PRESETS) -->
      <div id="panelTurnScore" class="hidden flex-1 flex flex-col">
        <div class="bg-slate-950 border border-slate-800 rounded-xl p-3 text-right mb-2.5 flex items-center justify-between">
          <span class="text-xs uppercase font-bold text-slate-500">Score de la volée</span>
          <span id="turnScoreDisplay" class="font-score text-4xl font-extrabold text-amber-400">0</span>
        </div>

        <div class="grid grid-cols-5 gap-1.5 mb-2.5">
          <button onclick="setTurnPreset(26)" class="btn-touch py-2 bg-slate-800 text-slate-300 font-bold rounded-lg text-sm border border-slate-700/60">26</button>
          <button onclick="setTurnPreset(45)" class="btn-touch py-2 bg-slate-800 text-slate-300 font-bold rounded-lg text-sm border border-slate-700/60">45</button>
          <button onclick="setTurnPreset(60)" class="btn-touch py-2 bg-slate-800 text-slate-300 font-bold rounded-lg text-sm border border-slate-700/60">60</button>
          <button onclick="setTurnPreset(100)" class="btn-touch py-2 bg-slate-800 text-amber-400 font-bold rounded-lg text-sm border border-amber-500/30">100</button>
          <button onclick="setTurnPreset(140)" class="btn-touch py-2 bg-slate-800 text-amber-400 font-bold rounded-lg text-sm border border-amber-500/30">140</button>
        </div>

        <div class="grid grid-cols-3 gap-2 flex-1">
          <button onclick="numpadPress(1)" class="btn-touch bg-slate-800 hover:bg-slate-700 text-white font-score text-2xl font-bold rounded-xl border border-slate-700/60">1</button>
          <button onclick="numpadPress(2)" class="btn-touch bg-slate-800 hover:bg-slate-700 text-white font-score text-2xl font-bold rounded-xl border border-slate-700/60">2</button>
          <button onclick="numpadPress(3)" class="btn-touch bg-slate-800 hover:bg-slate-700 text-white font-score text-2xl font-bold rounded-xl border border-slate-700/60">3</button>
          
          <button onclick="numpadPress(4)" class="btn-touch bg-slate-800 hover:bg-slate-700 text-white font-score text-2xl font-bold rounded-xl border border-slate-700/60">4</button>
          <button onclick="numpadPress(5)" class="btn-touch bg-slate-800 hover:bg-slate-700 text-white font-score text-2xl font-bold rounded-xl border border-slate-700/60">5</button>
          <button onclick="numpadPress(6)" class="btn-touch bg-slate-800 hover:bg-slate-700 text-white font-score text-2xl font-bold rounded-xl border border-slate-700/60">6</button>
          
          <button onclick="numpadPress(7)" class="btn-touch bg-slate-800 hover:bg-slate-700 text-white font-score text-2xl font-bold rounded-xl border border-slate-700/60">7</button>
          <button onclick="numpadPress(8)" class="btn-touch bg-slate-800 hover:bg-slate-700 text-white font-score text-2xl font-bold rounded-xl border border-slate-700/60">8</button>
          <button onclick="numpadPress(9)" class="btn-touch bg-slate-800 hover:bg-slate-700 text-white font-score text-2xl font-bold rounded-xl border border-slate-700/60">9</button>
          
          <button onclick="numpadClear()" class="btn-touch bg-rose-950/60 text-rose-300 font-bold text-lg rounded-xl border border-rose-800/40">C</button>
          <button onclick="numpadPress(0)" class="btn-touch bg-slate-800 hover:bg-slate-700 text-white font-score text-2xl font-bold rounded-xl border border-slate-700/60">0</button>
          <button onclick="setTurnPreset(180)" class="btn-touch bg-gradient-to-tr from-amber-600 to-rose-600 text-white font-score text-xl font-extrabold rounded-xl shadow-lg shadow-amber-500/20">180!</button>
        </div>

        <button onclick="confirmTurnScoreDirect()" class="btn-touch mt-2.5 w-full py-3.5 bg-gradient-to-r from-emerald-500 to-teal-500 text-slate-950 rounded-xl font-extrabold text-base flex items-center justify-center gap-2 shadow-lg shadow-emerald-500/25">
          <span>VALIDER LE SCORE</span>
          <i class="fa-solid fa-arrow-right"></i>
        </button>
      </div>

    </section>
  </main>

  <!-- MODAL: HISTORIQUE & PROGRESSION (NEW) -->
  <div id="historyModal" class="fixed inset-0 bg-black/80 backdrop-blur-md z-50 hidden flex items-center justify-center p-3 sm:p-5">
    <div class="bg-slate-900 border border-slate-800 rounded-3xl w-full max-w-4xl max-h-[92vh] flex flex-col shadow-2xl overflow-hidden">
      
      <!-- Modal Header -->
      <div class="flex items-center justify-between p-5 border-b border-slate-800 flex-none">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-amber-500/20 border border-amber-500/40 text-amber-400 flex items-center justify-center">
            <i class="fa-solid fa-chart-line text-lg"></i>
          </div>
          <div>
            <h2 class="text-xl font-bold text-white">Historique & Progression</h2>
            <p class="text-xs text-slate-400">Évolution de votre moyenne et suivi des victoires</p>
          </div>
        </div>
        <button onclick="closeHistoryModal()" class="w-9 h-9 rounded-full bg-slate-800 text-slate-400 hover:text-white flex items-center justify-center">
          <i class="fa-solid fa-xmark"></i>
        </button>
      </div>

      <!-- Modal Body (Scrollable) -->
      <div class="p-5 overflow-y-auto no-scrollbar space-y-6 flex-1">
        
        <!-- Global Stats Cards -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
          <div class="bg-slate-950/80 p-3.5 rounded-2xl border border-slate-800">
            <span class="text-[11px] font-bold uppercase text-slate-400">Parties jouées</span>
            <div id="statTotalGames" class="font-score text-3xl font-extrabold text-white mt-1">0</div>
            <span id="statWinRate" class="text-xs text-emerald-400 font-semibold">0% victoires</span>
          </div>

          <div class="bg-slate-950/80 p-3.5 rounded-2xl border border-slate-800">
            <span class="text-[11px] font-bold uppercase text-slate-400">Record Moyenne (3D)</span>
            <div id="statBestAvg" class="font-score text-3xl font-extrabold text-amber-400 mt-1">0.0</div>
            <span class="text-xs text-slate-400">Points / volée</span>
          </div>

          <div class="bg-slate-950/80 p-3.5 rounded-2xl border border-slate-800">
            <span class="text-[11px] font-bold uppercase text-slate-400">Total 180s</span>
            <div id="statTotal180" class="font-score text-3xl font-extrabold text-rose-400 mt-1">0</div>
            <span id="statTonsCount" class="text-xs text-slate-400">100+ : 0</span>
          </div>

          <div class="bg-slate-950/80 p-3.5 rounded-2xl border border-slate-800">
            <span class="text-[11px] font-bold uppercase text-slate-400">Meilleur Checkout</span>
            <div id="statBestCheckout" class="font-score text-3xl font-extrabold text-teal-400 mt-1">-</div>
            <span class="text-xs text-slate-400">Double Out</span>
          </div>
        </div>

        <!-- Progression Chart Section -->
        <div class="bg-slate-950/80 p-4 rounded-2xl border border-slate-800">
          <div class="flex items-center justify-between mb-3">
            <div class="flex items-center gap-2">
              <i class="fa-solid fa-arrow-trend-up text-amber-400 text-sm"></i>
              <h3 class="font-bold text-sm text-slate-200">Courbe de progression (Moyenne 3 flèches X01)</h3>
            </div>
            <span class="text-xs text-slate-400">15 dernières parties</span>
          </div>
          <div class="relative w-full h-44">
            <canvas id="progressionCanvas" class="w-full h-full rounded-xl bg-slate-900/60"></canvas>
            <div id="canvasEmptyMsg" class="absolute inset-0 flex items-center justify-center text-xs text-slate-500 font-medium">
              Aucune partie X01 enregistrée pour afficher le graphique.
            </div>
          </div>
        </div>

        <!-- Filter & Match History List -->
        <div>
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-3">
            <h3 class="font-bold text-sm text-slate-200 flex items-center gap-2">
              <i class="fa-solid fa-clock-rotate-left text-amber-400"></i> Historique des Matchs
            </h3>

            <!-- Filter tabs -->
            <div class="flex gap-1 bg-slate-950 p-1 rounded-xl border border-slate-800 text-xs font-semibold">
              <button onclick="filterHistory('ALL')" id="filterALL" class="px-2.5 py-1 rounded-lg bg-amber-500 text-slate-950 font-bold">Tous</button>
              <button onclick="filterHistory('X01')" id="filterX01" class="px-2.5 py-1 rounded-lg text-slate-400 hover:text-white">X01</button>
              <button onclick="filterHistory('CRICKET')" id="filterCRICKET" class="px-2.5 py-1 rounded-lg text-slate-400 hover:text-white">Cricket</button>
              <button onclick="filterHistory('TRAIN_CLOCK')" id="filterCLOCK" class="px-2.5 py-1 rounded-lg text-slate-400 hover:text-white">Entraînement</button>
            </div>
          </div>

          <!-- History items container -->
          <div id="historyListContainer" class="space-y-2.5">
            <!-- Dynamically populated -->
          </div>
        </div>

      </div>

      <!-- Footer action -->
      <div class="p-4 border-t border-slate-800 bg-slate-950/60 flex items-center justify-between flex-none">
