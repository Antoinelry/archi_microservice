       ========================================================================== */
    function saveLocalState() {
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(gameState));
      } catch (e) {}
    }

    function loadLocalState() {
      try {
        const saved = localStorage.getItem(STORAGE_KEY);
        if (saved) {
          const parsed = JSON.parse(saved);
          if (parsed && parsed.players && parsed.players.length > 0) {
            gameState = parsed;
          }
        }
      } catch (e) {}

      try {
        const savedHist = localStorage.getItem(HISTORY_KEY);
        if (savedHist) {
          matchHistory = JSON.parse(savedHist);
        }
      } catch (e) {}
    }

    function saveMatchToHistory(winner, details = {}) {
      const matchRecord = {
        id: Date.now(),
        date: new Date().toLocaleDateString('fr-FR', { day: '2-digit', month: '2-digit', hour: '2-digit', minute: '2-digit' }),
        mode: gameState.mode,
        targetScore: gameState.targetScore,
        winnerName: winner.name,
        players: gameState.players.map(p => {
          const avg3 = p.dartsThrown > 0 ? (((gameState.mode === 'X01' ? (gameState.targetScore - p.score) : p.score) / p.dartsThrown) * 3).toFixed(1) : "0.0";
          return {
            name: p.name,
            score: p.score,
            dartsThrown: p.dartsThrown,
            avg3: parseFloat(avg3),
            tons100: p.tons100 || 0,
            tons140: p.tons140 || 0,
            tons180: p.tons180 || 0,
            highestCheckout: p.highestCheckout || 0
          };
        }),
        winnerAvg3: winner.dartsThrown > 0 ? parseFloat((((gameState.mode === 'X01' ? gameState.targetScore : winner.score) / winner.dartsThrown) * 3).toFixed(1)) : 0,
        totalDarts: winner.dartsThrown
      };

      matchHistory.unshift(matchRecord);
      if (matchHistory.length > 100) matchHistory.pop(); // keep last 100
      try {
        localStorage.setItem(HISTORY_KEY, JSON.stringify(matchHistory));
      } catch (e) {}
    }

    function saveStateForUndo() {
      const clone = JSON.parse(JSON.stringify({
        mode: gameState.mode,
        targetScore: gameState.targetScore,
        doubleOut: gameState.doubleOut,
        activePlayerIndex: gameState.activePlayerIndex,
        turnNumber: gameState.turnNumber,
        players: gameState.players
      }));
      gameState.historyStack.push(clone);
      if (gameState.historyStack.length > 25) {
        gameState.historyStack.shift();
      }
    }

    function undoLastAction() {
      if (!gameState.historyStack || gameState.historyStack.length === 0) return;
      const prev = gameState.historyStack.pop();
      gameState.mode = prev.mode;
      gameState.targetScore = prev.targetScore;
      gameState.doubleOut = prev.doubleOut;
      gameState.activePlayerIndex = prev.activePlayerIndex;
      gameState.turnNumber = prev.turnNumber;
      gameState.players = prev.players;

      resetCurrentTurnInput();
      updateUI();
      saveLocalState();
      playTone(400, 'sine', 0.1);
    }

