              <h3 class="font-bold text-lg text-white truncate">${player.name}</h3>
            </div>
            <span class="text-xs px-2 py-0.5 rounded-full bg-slate-800 text-slate-400 font-semibold border border-slate-700/60">
              Legs: <b class="text-amber-400">${player.legsWon}</b>
            </span>
          </div>
        `;

        let middleHtml = "";
        if (gameState.mode === 'X01') {
          middleHtml = `
            <div class="my-auto py-3 text-center">
              <span class="text-xs uppercase font-extrabold tracking-widest text-slate-400">Restant</span>
              <div class="font-score text-6xl sm:text-7xl font-extrabold ${isActive ? 'text-white text-glow' : 'text-slate-300'} my-1 tracking-tight">
                ${player.score}
              </div>
              <div class="text-xs text-slate-400 flex justify-center gap-3 font-medium">
                <span>Fléchettes: <b class="text-slate-200">${player.dartsThrown}</b></span>
                <span>•</span>
                <span>Moy. (3D): <b class="text-amber-400">${avg3}</b></span>
              </div>
            </div>
          `;
        } else if (gameState.mode === 'CRICKET') {
          let gridRows = CRICKET_NUMBERS.map(num => {
            const hits = player.cricketHits[num] || 0;
            let mark = "-";
            if (hits === 1) mark = "/";
            if (hits === 2) mark = "X";
            if (hits >= 3) mark = "⨂";
            return `
              <div class="flex items-center justify-between py-0.5 px-2 text-xs bg-slate-900/60 rounded">
                <span class="font-bold text-slate-400">${num === 'B' ? 'BULL' : num}</span>
                <span class="font-score font-bold ${hits >= 3 ? 'text-emerald-400' : 'text-amber-400'}">${mark}</span>
              </div>
            `;
          }).join('');

          middleHtml = `
            <div class="my-auto py-1">
              <div class="text-center mb-1">
                <span class="text-xs uppercase font-extrabold text-slate-400">Score</span>
                <div class="font-score text-4xl font-extrabold text-amber-400">${player.score}</div>
              </div>
              <div class="grid grid-cols-2 gap-1 bg-slate-950/60 p-2 rounded-xl border border-slate-800/80">
                ${gridRows}
              </div>
            </div>
          `;
        } else if (gameState.mode === 'TRAIN_BOBS27') {
          const currentD = player.bobsDouble || 1;
          const targetLabel = currentD === 21 ? 'BULL (50)' : `DOUBLE ${currentD}`;
          const pen = currentD === 21 ? 50 : currentD * 2;
          middleHtml = `
            <div class="my-auto py-2 text-center">
              <span class="text-xs uppercase font-extrabold tracking-widest text-slate-400">Score en cours</span>
              <div class="font-score text-6xl sm:text-7xl font-extrabold ${player.score <= 10 ? 'text-rose-400' : 'text-amber-400 text-glow'} my-1 tracking-tight">
                ${player.score}
              </div>
              <div class="mt-2 py-1.5 px-3 rounded-xl bg-slate-950/80 border border-amber-500/30 inline-block">
                <span class="text-[11px] uppercase font-bold text-slate-400">Cible : </span>
                <span class="font-score font-bold text-emerald-400 text-base ml-1">${targetLabel}</span>
                <span class="text-[10px] text-slate-500 ml-2">(-${pen} si raté)</span>
              </div>
            </div>
          `;
        } else {
          const targetName = player.clockTarget > 20 ? 'BULL' : player.clockTarget;
          middleHtml = `
            <div class="my-auto py-4 text-center">
              <span class="text-xs uppercase font-extrabold tracking-widest text-emerald-400">Cible à toucher</span>
              <div class="font-score text-6xl sm:text-7xl font-extrabold text-white text-glow my-2">
                ${targetName}
              </div>
              <div class="text-xs text-slate-400 font-medium">
                Fléchettes lancées: <b class="text-amber-400">${player.dartsThrown}</b>
              </div>
            </div>
          `;
        }

        const lastTurn = player.history[0];
        let footerHtml = `
          <div class="pt-2 border-t border-slate-800/60 flex items-center justify-between text-[11px] text-slate-400">
            <span>Dernier tour:</span>
            <span class="font-semibold text-slate-300">
              ${lastTurn ? (lastTurn.bust ? '<span class="text-rose-400">Bust</span>' : `+${lastTurn.score} pts (${lastTurn.darts} fl.)`) : 'En attente'}
            </span>
          </div>
        `;

        card.innerHTML = topHtml + middleHtml + footerHtml;
        card.onclick = () => {
          gameState.activePlayerIndex = idx;
          updateUI();
        };
        container.appendChild(card);
      });
    }

    function renderCheckoutCard() {
      const activePlayer = gameState.players[gameState.activePlayerIndex];
      const el = document.getElementById('checkoutSuggestion');
      const box = document.getElementById('checkoutCard');
      const modeBadge = document.getElementById('checkoutModeBadge');

      const isDoubleOut = !!gameState.doubleOut;
      if (modeBadge) {
        modeBadge.textContent = isDoubleOut ? "Double Out" : "Straight Out";
      }

      let suggestion = null;

      if (isDoubleOut) {
        if (activePlayer.score <= 170) {
          suggestion = CHECKOUTS_DOUBLE[activePlayer.score] || null;
        }
      } else {
        // En Straight Out, tout score <= 180 peut être fini
        if (activePlayer.score <= 180) {
          suggestion = getStraightOutCheckout(activePlayer.score);
        }
      }

      if (suggestion) {
        box.classList.remove('opacity-40');
        el.textContent = `${suggestion} (${activePlayer.score})`;
      } else {
        box.classList.add('opacity-40');
        const maxFinishingScore = isDoubleOut ? 170 : 180;
        el.textContent = activePlayer.score <= maxFinishingScore 
          ? "Pas de finition directe" 
          : `Score: ${activePlayer.score} (Réduire le score)`;
      }
    }

    function showCelebration(title, sub, icon, colorClass = "text-amber-400") {
      const overlay = document.getElementById('celebrationOverlay');
      const box = document.getElementById('celebrationContent');
      const iconElem = document.getElementById('celebrationIcon');
      const titleElem = document.getElementById('celebrationTitle');
      const subElem = document.getElementById('celebrationSubtitle');

      iconElem.className = `fa-solid ${icon} text-6xl ${colorClass} mb-3 animate-bounce`;
      titleElem.textContent = title;
      subElem.textContent = sub;

      overlay.classList.remove('hidden');
      setTimeout(() => box.classList.remove('scale-90'), 20);

      setTimeout(() => {
        box.classList.add('scale-90');
        setTimeout(() => overlay.classList.add('hidden'), 250);
      }, 1600);
    }

    /* ==========================================================================
       MODAL: NEW GAME SETUP
       ========================================================================== */
    let tempModalMode = 'X01';
    let tempModalTarget = 501;

    function openNewGameModal() {
      document.getElementById('newGameModal').classList.remove('hidden');
      renderPlayerInputs();
    }

    function closeNewGameModal() {
      document.getElementById('newGameModal').classList.add('hidden');
    }

    function selectModalGameType(type) {
      tempModalMode = type;
      ['btnOptX01', 'btnOptCricket', 'btnOptClock', 'btnOptBobs27'].forEach(id => {
        const btn = document.getElementById(id);
        if (btn) btn.className = "w-full h-full py-3 px-2 pr-7 rounded-xl border text-center font-bold text-sm transition bg-slate-800 border-slate-700 text-slate-300";
      });

      const optX01Box = document.getElementById('x01Options');
      if (type === 'X01') {
        document.getElementById('btnOptX01').className = "w-full h-full py-3 px-2 pr-7 rounded-xl border text-center font-bold text-sm transition bg-amber-500/20 border-amber-500 text-amber-300";
        optX01Box.classList.remove('hidden');
      } else if (type === 'CRICKET') {
        document.getElementById('btnOptCricket').className = "w-full h-full py-3 px-2 pr-7 rounded-xl border text-center font-bold text-sm transition bg-amber-500/20 border-amber-500 text-amber-300";
        optX01Box.classList.add('hidden');
      } else if (type === 'TRAIN_CLOCK') {
        document.getElementById('btnOptClock').className = "w-full h-full py-3 px-2 pr-7 rounded-xl border text-center font-bold text-sm transition bg-amber-500/20 border-amber-500 text-amber-300";
        optX01Box.classList.add('hidden');
      } else if (type === 'TRAIN_BOBS27') {
        document.getElementById('btnOptBobs27').className = "w-full h-full py-3 px-2 pr-7 rounded-xl border text-center font-bold text-sm transition bg-amber-500/20 border-amber-500 text-amber-300";
        optX01Box.classList.add('hidden');
      }
    }

    const GAME_RULES_DATA = {
      'X01': {
        title: "X01 (301, 501, 701, 901)",
        subtitle: "Règle officielle des tournois (PDC / WDF)",
        html: `
          <div class="bg-slate-950 p-3 rounded-xl border border-slate-800">
            <p class="font-bold text-white mb-1"><i class="fa-solid fa-bullseye text-amber-400 mr-1.5"></i>Objectif</p>
            <p>Être le premier à réduire son score initial exactement à <strong>0</strong>.</p>
          </div>
          <div class="space-y-2">
            <p class="font-bold text-white">Déroulement :</p>
            <ul class="list-disc list-inside space-y-1 text-slate-400 pl-1">
              <li>Chaque joueur lance une volée de <strong>3 fléchettes</strong> à tour de rôle.</li>
              <li>Le total des points de la volée est soustrait du total restant.</li>
            </ul>
          </div>
          <div class="bg-amber-500/10 border border-amber-500/30 p-3 rounded-xl text-amber-200">
            <p class="font-bold mb-1"><i class="fa-solid fa-flag-checkered mr-1.5"></i>Option Double Out :</p>
            <p class="text-xs leading-relaxed text-amber-300/90">La dernière flèche qui atteint 0 doit impérativement être un <strong>Double</strong> ou le <strong>Double-Bull (50)</strong>. Si le joueur passe en dessous de 0 ou atteint 1, c'est un <em>Bust</em> (la volée est annulée).</p>
          </div>
        `
      },
      'CRICKET': {
        title: "Cricket",
        subtitle: "Stratégie et précision",
        html: `
          <div class="bg-slate-950 p-3 rounded-xl border border-slate-800">
            <p class="font-bold text-white mb-1"><i class="fa-solid fa-bullseye text-amber-400 mr-1.5"></i>Objectif</p>
            <p>Ouvrir et fermer tous les segments clés (<strong>15, 16, 17, 18, 19, 20 et Bull</strong>) tout en ayant un score supérieur ou égal à ses adversaires.</p>
          </div>
          <div class="space-y-2">
            <p class="font-bold text-white">Mécanique :</p>
            <ul class="list-disc list-inside space-y-1 text-slate-400 pl-1">
              <li>Il faut toucher <strong>3 fois</strong> chaque secteur pour l'ouvrir (Simple = 1 touche, Double = 2, Triple = 3).</li>
              <li>Une fois ouvert chez vous, chaque touche supplémentaire sur ce segment vous rapporte des points, tant qu'au moins un adversaire ne l'a pas encore ouvert.</li>
              <li>Quand <em>tous les joueurs</em> ont ouvert le même secteur, il est définitivement fermé et ne rapporte plus de points.</li>
            </ul>
          </div>
        `
      },
      'TRAIN_CLOCK': {
        title: "Tour du Cadran (Around the Clock)",
        subtitle: "Entraînement régularité solo ou multijoueur",
        html: `
          <div class="bg-slate-950 p-3 rounded-xl border border-slate-800">
            <p class="font-bold text-white mb-1"><i class="fa-solid fa-bullseye text-amber-400 mr-1.5"></i>Objectif</p>
            <p>Parcourir la cible dans l'ordre numérique croissant du <strong>1 jusqu'au 20</strong>, puis terminer par le <strong>Bull</strong>.</p>
          </div>
          <div class="space-y-2">
            <p class="font-bold text-white">Règles :</p>
            <ul class="list-disc list-inside space-y-1 text-slate-400 pl-1">
              <li>Une flèche ne compte que si elle touche la cible en cours demandée.</li>
              <li>Dès qu'un numéro est touché, la cible passe immédiatement au numéro suivant.</li>
              <li>Le vainqueur est celui qui boucle le tour complet avec le moins de fléchettes possible.</li>
            </ul>
          </div>
        `
      },
      'TRAIN_BOBS27': {
        title: "Bob's 27",
        subtitle: "Entraînement officiel aux Doubles (Bob Anderson)",
        html: `
          <div class="bg-slate-950 p-3 rounded-xl border border-slate-800">
            <p class="font-bold text-white mb-1"><i class="fa-solid fa-bullseye text-amber-400 mr-1.5"></i>Objectif</p>
            <p>Terminer le parcours du <strong>Double 1 jusqu'au Bullseye (D25)</strong> sans que votre capital de points ne tombe à 0.</p>
          </div>
          <div class="space-y-2">
            <p class="font-bold text-white">Calcul des points :</p>
            <ul class="list-disc list-inside space-y-1 text-slate-400 pl-1">
              <li>Vous démarrez la partie avec un capital fixe de <strong>27 points</strong>.</li>
              <li>À chaque tour, vous lancez 3 flèches sur le double imposé (D1 au tour 1, D2 au tour 2...).</li>
              <li>Chaque touche dans le double ajoute sa valeur à votre score (ex: 2 flèches dans le D10 = +40 pts).</li>
              <li><strong>Pénalité :</strong> Si les 3 fléchettes ratent le double, la valeur du double est soustraite (ex: -20 pts pour D10).</li>
            </ul>
          </div>
          <div class="bg-rose-950/40 border border-rose-900/50 p-3 rounded-xl text-rose-300 text-xs">
            <strong>Game Over immédiat :</strong> Si votre score tombe à 0 ou en négatif à n'importe quel moment, la partie s'arrête !
          </div>
        `
      }
    };

    function showModeRules(modeKey) {
      const data = GAME_RULES_DATA[modeKey];
      if (!data) return;
      document.getElementById('rulesModalTitle').textContent = data.title;
      document.getElementById('rulesModalSubtitle').textContent = data.subtitle;
      document.getElementById('rulesModalContent').innerHTML = data.html;
      document.getElementById('rulesModal').classList.remove('hidden');
    }

    function closeRulesModal() {
      document.getElementById('rulesModal').classList.add('hidden');
    }

    function setX01Target(val) {
      tempModalTarget = val;
      document.querySelectorAll('.x01TargetBtn').forEach(btn => {
        if (parseInt(btn.textContent) === val) {
          btn.className = "x01TargetBtn py-2.5 rounded-xl border text-sm font-bold bg-amber-500/20 border-amber-500 text-amber-300";
        } else {
          btn.className = "x01TargetBtn py-2.5 rounded-xl border text-sm font-bold bg-slate-800 border-slate-700 text-slate-300";
        }
      });
    }

    function renderPlayerInputs() {
      const container = document.getElementById('playerInputsList');
      container.innerHTML = "";

      gameState.players.forEach((p, idx) => {
        const row = document.createElement('div');
        row.className = "flex items-center gap-2";
        row.innerHTML = `
          <input type="text" value="${p.name}" class="playerNameInput flex-1 bg-slate-950 border border-slate-800 px-3.5 py-2.5 rounded-xl text-white font-medium focus:outline-none focus:border-amber-500" placeholder="Nom joueur ${idx + 1}">
          ${gameState.players.length > 1 ? `
            <button onclick="removePlayerField(${idx})" class="w-10 h-10 rounded-xl bg-slate-800 hover:bg-rose-900/50 text-slate-400 hover:text-rose-400 flex items-center justify-center">
              <i class="fa-solid fa-trash text-sm"></i>
            </button>
          ` : ''}
        `;
        container.appendChild(row);
      });
    }

    function addPlayerField() {
      if (gameState.players.length >= 6) return;
      gameState.players.push({
        id: Date.now(),
        name: `Joueur ${gameState.players.length + 1}`,
        score: tempModalTarget,
        dartsThrown: 0,
        legsWon: 0,
        history: [],
        cricketHits: {},
        clockTarget: 1
      });
      renderPlayerInputs();
    }

    function removePlayerField(idx) {
      if (gameState.players.length <= 1) return;
      gameState.players.splice(idx, 1);
      renderPlayerInputs();
    }

    function startNewGameFromModal() {
      const inputs = document.querySelectorAll('.playerNameInput');
      const newPlayers = [];
      inputs.forEach((inp, i) => {
        const name = inp.value.trim() || `Joueur ${i + 1}`;
        newPlayers.push({
          id: i + 1,
          name: name,
          score: tempModalMode === 'X01' ? tempModalTarget : (tempModalMode === 'TRAIN_BOBS27' ? 27 : 0),
          dartsThrown: 0,
          legsWon: 0,
          history: [],
          cricketHits: {},
          clockTarget: 1,
          bobsDouble: 1
        });
      });

      gameState.mode = tempModalMode;
      gameState.targetScore = tempModalTarget;
      gameState.doubleOut = document.getElementById('chkDoubleOut').checked;
      gameState.activePlayerIndex = 0;
      gameState.turnNumber = 1;
      gameState.players = newPlayers;
      gameState.historyStack = [];

      resetCurrentTurnInput();
      closeNewGameModal();
      updateUI();
      saveLocalState();
    }

    /* ==========================================================================
       STARTUP INIT
       ========================================================================== */
    window.addEventListener('DOMContentLoaded', () => {
      loadLocalState();
      updateUI();
      setInputMode('dartByDart');
      document.addEventListener('touchstart', function() {}, {passive: true});
    });
  </script>
</body>
</html>
