    function setMultiplier(mult) {
      currentMultiplier = mult;
      ['btnMult1', 'btnMult2', 'btnMult3'].forEach((id, idx) => {
        const btn = document.getElementById(id);
        if (idx + 1 === mult) {
          btn.className = "btn-touch py-3 rounded-xl font-bold text-sm bg-amber-500 text-slate-950 shadow-md ring-2 ring-amber-300";
        } else {
          btn.className = "btn-touch py-3 rounded-xl font-bold text-sm bg-slate-800 text-slate-300 border border-slate-700/70";
        }
      });
      playTone(450, 'sine', 0.05);
    }

    function handleDartValue(val) {
      if (turnDarts.length >= 3) return;
      const mult = currentMultiplier;
      const score = val * mult;
      let label = (mult === 2 ? 'D' : mult === 3 ? 'T' : 'S') + val;

      turnDarts.push({ mult, val, score, label });
      playSoundEffect('dart');
      updateTurnDartsDisplay();
      setMultiplier(1);

      if (gameState.mode === 'X01') {
        const p = gameState.players[gameState.activePlayerIndex];
        const currentSum = turnDarts.reduce((acc, d) => acc + d.score, 0);
        const rem = p.score - currentSum;
        if (rem === 0) {
          if (!gameState.doubleOut || mult === 2 || (val === 25 && mult === 2)) {
            confirmTurnDarts();
            return;
          }
        }
      }
    }

    function handleDartSpecial(type) {
      if (turnDarts.length >= 3) return;
      if (type === 'miss') {
        turnDarts.push({ mult: 0, val: 0, score: 0, label: 'MISS' });
        playTone(200, 'sine', 0.1);
      } else if (type === 'bull') {
        turnDarts.push({ mult: 1, val: 25, score: 25, label: 'BULL' });
        playSoundEffect('dart');
      } else if (type === 'doubleBull') {
        turnDarts.push({ mult: 2, val: 25, score: 50, label: 'D-BULL' });
        playSoundEffect('dart');
      }
      setMultiplier(1);
      updateTurnDartsDisplay();
    }

    function updateTurnDartsDisplay() {
      for (let i = 0; i < 3; i++) {
        const slot = document.getElementById(`dartSlot${i}`);
        const txt = slot.querySelector('.slot-text');
        if (turnDarts[i]) {
          txt.textContent = turnDarts[i].label;
          slot.classList.add('border-amber-500/80', 'bg-amber-500/10');
        } else {
          txt.textContent = '-';
          slot.classList.remove('border-amber-500/80', 'bg-amber-500/10');
        }
      }
    }

    function resetCurrentTurnInput() {
      turnDarts = [];
      turnNumpadValue = "";
      updateTurnDartsDisplay();
      document.getElementById('turnScoreDisplay').textContent = "0";
      setMultiplier(1);
    }

    function numpadPress(digit) {
      if (turnNumpadValue.length >= 3) return;
      turnNumpadValue += digit.toString();
      const num = parseInt(turnNumpadValue, 10);
      if (num > 180) turnNumpadValue = "180";
      document.getElementById('turnScoreDisplay').textContent = turnNumpadValue;
      playTone(500, 'sine', 0.05);
    }

    function numpadClear() {
      turnNumpadValue = "";
      document.getElementById('turnScoreDisplay').textContent = "0";
      playTone(250, 'sine', 0.05);
    }

    function setTurnPreset(val) {
      turnNumpadValue = val.toString();
      document.getElementById('turnScoreDisplay').textContent = turnNumpadValue;
      playTone(550, 'sine', 0.05);
    }

    function confirmTurnScoreDirect() {
      const score = parseInt(turnNumpadValue, 10) || 0;
      applyTurnScore(score, 3, [{ score: score, label: `${score} pts` }]);
      resetCurrentTurnInput();
    }

    function confirmTurnDarts() {
      if (turnDarts.length === 0) return;
      const totalScore = turnDarts.reduce((acc, d) => acc + d.score, 0);
      applyTurnScore(totalScore, turnDarts.length, [...turnDarts]);
      resetCurrentTurnInput();
    }

    /* Apply Turn Score across game modes */
    function applyTurnScore(totalTurnScore, dartsCount, details = []) {
      saveStateForUndo();
      const player = gameState.players[gameState.activePlayerIndex];
      if (!player.tons100) player.tons100 = 0;
      if (!player.tons140) player.tons140 = 0;
      if (!player.tons180) player.tons180 = 0;
      if (!player.highestCheckout) player.highestCheckout = 0;

      // Track 100+, 140+, 180 milestones
      if (totalTurnScore === 180) player.tons180 += 1;
      else if (totalTurnScore >= 140) player.tons140 += 1;
      else if (totalTurnScore >= 100) player.tons100 += 1;

      if (gameState.mode === 'X01') {
        const remaining = player.score - totalTurnScore;
        const lastDart = details[details.length - 1] || { mult: 1, val: 0 };

        let isBust = false;
        if (remaining < 0) isBust = true;
        if (gameState.doubleOut) {
          if (remaining === 1) isBust = true;
          if (remaining === 0 && lastDart.mult !== 2) isBust = true;
        }

        if (isBust) {
          playSoundEffect('bust');
          showCelebration("BUST !", "Score inchangé", "fa-ban", "text-rose-500");
          player.history.unshift({ turn: gameState.turnNumber, score: 0, bust: true, darts: dartsCount });
          player.dartsThrown += dartsCount;
        } else {
          const checkoutScore = player.score;
          player.score = remaining;
          player.dartsThrown += dartsCount;
          player.history.unshift({ turn: gameState.turnNumber, score: totalTurnScore, bust: false, darts: dartsCount });

          if (totalTurnScore === 180) {
            playSoundEffect('180');
            showCelebration("180 !", "Maximum exceptionnel !", "fa-fire", "text-amber-400");
          }

          // Check Win
          if (player.score === 0) {
            player.legsWon += 1;
            if (checkoutScore > player.highestCheckout) player.highestCheckout = checkoutScore;
            
            // Save to Match Progression History
            saveMatchToHistory(player);

            playSoundEffect('win');
            showCelebration(`${player.name.toUpperCase()} GAGNE !`, `En ${player.dartsThrown} fléchettes (Moy: ${(gameState.targetScore / player.dartsThrown * 3).toFixed(1)})`, "fa-trophy", "text-amber-400");
            
            setTimeout(() => {
              resetScoresForNextLeg();
            }, 1800);
            updateUI();
            saveLocalState();
            return;
          }
        }
      } else if (gameState.mode === 'CRICKET') {
        details.forEach(dart => {
          let target = dart.val;
          if (target === 25) target = 'B';
          if (CRICKET_NUMBERS.includes(target)) {
            const hits = dart.mult || 1;
            applyCricketHit(player, target, hits);
          }
        });
        player.dartsThrown += dartsCount;
        player.history.unshift({ turn: gameState.turnNumber, score: totalTurnScore, darts: dartsCount });
        checkCricketWin();
      } else if (gameState.mode === 'TRAIN_CLOCK') {
        let hitsThisTurn = 0;
        details.forEach(dart => {
          let currentWanted = player.clockTarget;
          let hit = false;
          if (currentWanted <= 20 && dart.val === currentWanted) hit = true;
          if (currentWanted === 21 && (dart.val === 25)) hit = true;
          if (hit) {
            player.clockTarget += 1;
            hitsThisTurn++;
            playTone(800, 'sine', 0.12);
          }
        });
        player.dartsThrown += dartsCount;
        player.score = player.clockTarget - 1;
        player.history.unshift({ turn: gameState.turnNumber, score: hitsThisTurn, darts: dartsCount });

        if (player.clockTarget > 21) {
          saveMatchToHistory(player);
          playSoundEffect('win');
          showCelebration("TOUR TERMINÉ !", `En ${player.dartsThrown} fléchettes !`, "fa-bullseye", "text-emerald-400");
          setTimeout(() => resetScoresForNextLeg(), 1800);
        }
      } else if (gameState.mode === 'TRAIN_BOBS27') {
        // Mode Bob's 27 : calcul des points sur le double en cours
        const currentD = player.bobsDouble || 1;
        const doubleValue = currentD === 21 ? 50 : (currentD * 2);

        // Compter combien de fois le double cible a été touché
        let hitsOnTarget = 0;
        details.forEach(dart => {
          if (currentD <= 20 && dart.val === currentD && dart.mult === 2) hitsOnTarget++;
          if (currentD === 21 && dart.val === 25 && dart.mult === 2) hitsOnTarget++;
        });

        let delta = 0;
        if (hitsOnTarget > 0) {
          delta = hitsOnTarget * doubleValue;
          player.score += delta;
          playTone(600 + (hitsOnTarget * 100), 'triangle', 0.18);
        } else {
          delta = -doubleValue;
          player.score -= doubleValue;
          playSoundEffect('bust');
        }

        player.dartsThrown += dartsCount;
        player.history.unshift({ 
          turn: gameState.turnNumber, 
          target: currentD === 21 ? 'Bull' : `D${currentD}`,
          hits: hitsOnTarget,
          score: delta, 
          darts: dartsCount 
        });

        // Détection Game Over (score <= 0)
        if (player.score <= 0) {
          player.score = 0;
          showCelebration("GAME OVER", `Éliminé au D${currentD === 21 ? 'Bull' : currentD}`, "fa-skull-crossbones", "text-rose-500");
          speakAnnounce("Game Over !");
          saveMatchToHistory(player);
          setTimeout(() => resetScoresForNextLeg(), 2000);
          updateUI();
          saveLocalState();
          return;
        }

        // Passage au double suivant
        player.bobsDouble += 1;

        // Victoire si on termine le Bullseye (après 21)
        if (player.bobsDouble > 21) {
          saveMatchToHistory(player);
          playSoundEffect('win');
          showCelebration("BOB'S 27 TERMINÉ !", `Score Final Exceptionnel: ${player.score} pts`, "fa-trophy", "text-amber-400");
          setTimeout(() => resetScoresForNextLeg(), 2200);
        }
      }

      gameState.activePlayerIndex = (gameState.activePlayerIndex + 1) % gameState.players.length;
      if (gameState.activePlayerIndex === 0) {
        gameState.turnNumber += 1;
      }

      updateUI();
      saveLocalState();
    }

    function applyCricketHit(activePlayer, targetKey, hitCount) {
      if (!activePlayer.cricketHits[targetKey]) activePlayer.cricketHits[targetKey] = 0;
      const currentHits = activePlayer.cricketHits[targetKey];
      
      const isClosedByAllOthers = gameState.players
        .filter(p => p.id !== activePlayer.id)
        .every(p => (p.cricketHits[targetKey] || 0) >= 3);

      const neededToClose = Math.max(0, 3 - currentHits);
      const hitsAppliedToClose = Math.min(hitCount, neededToClose);
      activePlayer.cricketHits[targetKey] += hitsAppliedToClose;

      const surplusHits = hitCount - hitsAppliedToClose;
      if (surplusHits > 0 && !isClosedByAllOthers) {
        const pointVal = targetKey === 'B' ? 25 : parseInt(targetKey, 10);
        activePlayer.score += surplusHits * pointVal;
      }
    }

    function checkCricketWin() {
      gameState.players.forEach(p => {
        const closedAll = CRICKET_NUMBERS.every(num => (p.cricketHits[num] || 0) >= 3);
        const highestScore = gameState.players.every(other => p.score >= other.score);
        if (closedAll && highestScore) {
          saveMatchToHistory(p);
          playSoundEffect('win');
          showCelebration(`${p.name.toUpperCase()} GAGNE !`, `Cricket complété avec ${p.score} points !`, "fa-trophy", "text-amber-400");
          setTimeout(() => resetScoresForNextLeg(), 1800);
        }
      });
    }

    function resetScoresForNextLeg() {
      gameState.players.forEach(p => {
        p.score = gameState.targetScore;
        p.dartsThrown = 0;
        p.cricketHits = {};
        p.clockTarget = 1;
        p.history = [];
      });
      gameState.turnNumber = 1;
      gameState.activePlayerIndex = 0;
      updateUI();
    }

