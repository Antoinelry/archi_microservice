        tabTurn.className = "flex-1 py-2 rounded-lg transition bg-amber-500 text-slate-950 font-bold flex items-center justify-center gap-2";
        tabDart.className = "flex-1 py-2 rounded-lg transition text-slate-400 hover:text-white font-semibold flex items-center justify-center gap-2";
        panelTurn.classList.remove('hidden');
        panelDart.classList.add('hidden');
