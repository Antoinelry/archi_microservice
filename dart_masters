    /**
     * Calcule le chemin optimal de finition en Simple Out (Straight Out) jusqu'à 180 points.
     */
    function getStraightOutCheckout(score) {
      if (score <= 0 || score > 180) return null;

      // 1 fléchette directe
      if (score <= 20) return `${score}`;
      if (score === 25) return "25 (Bull)";
      if (score === 50) return "Bull (50)";
      if (score % 2 === 0 && score <= 40) return `D${score / 2} (${score})`;
      if (score % 3 === 0 && score <= 60) return `T${score / 3} (${score})`;

      // 2 fléchettes
      // Priorité à une grosse flèche initiale (T20, T19, T18, T17, 20)
      const testDarts = [
        { label: "T20", val: 60 },
        { label: "T19", val: 57 },
        { label: "T18", val: 54 },
        { label: "Bull", val: 50 },
        { label: "T17", val: 51 },
        { label: "20", val: 20 },
        { label: "25", val: 25 }
      ];

      for (const d1 of testDarts) {
        const rem = score - d1.val;
        if (rem > 0) {
          if (rem <= 20) return `${d1.label}, ${rem}`;
          if (rem === 25) return `${d1.label}, 25`;
          if (rem === 50) return `${d1.label}, Bull`;
          if (rem % 3 === 0 && rem <= 60) return `${d1.label}, T${rem / 3}`;
          if (rem % 2 === 0 && rem <= 40) return `${d1.label}, D${rem / 2}`;
        }
      }

      // 3 fléchettes (Jusqu'à 180)
      for (const d1 of testDarts) {
        for (const d2 of testDarts) {
          const rem = score - d1.val - d2.val;
          if (rem > 0) {
            if (rem <= 20) return `${d1.label}, ${d2.label}, ${rem}`;
            if (rem === 25) return `${d1.label}, ${d2.label}, 25`;
            if (rem === 50) return `${d1.label}, ${d2.label}, Bull`;
            if (rem % 3 === 0 && rem <= 60) return `${d1.label}, ${d2.label}, T${rem / 3}`;
            if (rem % 2 === 0 && rem <= 40) return `${d1.label}, ${d2.label}, D${rem / 2}`;
          }
        }
      }

      return null;
    }

    const CRICKET_NUMBERS = [20, 19, 18, 17, 16, 15, 'B'];

    // Main Active Game State
    let gameState = {
      mode: 'X01', // 'X01', 'CRICKET', 'TRAIN_CLOCK', 'TRAIN_BOBS27'
