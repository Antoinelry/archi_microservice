    function renderProgressionChart() {
      const canvas = document.getElementById('progressionCanvas');
      const emptyMsg = document.getElementById('canvasEmptyMsg');
      const ctx = canvas.getContext('2d');

      // Filter only completed X01 matches (chronological order)
      const x01Data = [...matchHistory]
        .filter(m => m.mode === 'X01' && m.winnerAvg3 > 0)
        .reverse()
        .slice(-15);

      if (x01Data.length < 2) {
        emptyMsg.classList.remove('hidden');
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        return;
      }
      emptyMsg.classList.add('hidden');

      // Adjust high DPI canvas resolution
      const rect = canvas.getBoundingClientRect();
      canvas.width = rect.width * window.devicePixelRatio;
      canvas.height = rect.height * window.devicePixelRatio;
      ctx.scale(window.devicePixelRatio, window.devicePixelRatio);

      const width = rect.width;
      const height = rect.height;
      const padding = 25;

      const points = x01Data.map(d => d.winnerAvg3);
      const minVal = Math.max(0, Math.floor(Math.min(...points) - 5));
      const maxVal = Math.ceil(Math.max(...points) + 5);

      ctx.clearRect(0, 0, width, height);

      // Draw subtle grid lines
      ctx.strokeStyle = "rgba(51, 65, 85, 0.4)";
      ctx.lineWidth = 1;
      for (let i = 0; i <= 3; i++) {
        const y = padding + (i * (height - padding * 2)) / 3;
        ctx.beginPath();
        ctx.moveTo(padding, y);
        ctx.lineTo(width - padding, y);
        ctx.stroke();

        // Label
        const val = (maxVal - (i * (maxVal - minVal)) / 3).toFixed(0);
        ctx.fillStyle = "rgba(148, 163, 184, 0.6)";
        ctx.font = "10px Chakra Petch, monospace";
        ctx.fillText(val, 4, y + 3);
      }

      // Compute coordinate points
      const stepX = (width - padding * 2) / (points.length - 1);
      const coords = points.map((p, idx) => {
        const x = padding + idx * stepX;
        const y = height - padding - ((p - minVal) / (maxVal - minVal)) * (height - padding * 2);
        return { x, y, val: p };
      });

      // Draw Gradient Area below curve
      const gradient = ctx.createLinearGradient(0, padding, 0, height);
      gradient.addColorStop(0, "rgba(245, 158, 11, 0.35)");
      gradient.addColorStop(1, "rgba(245, 158, 11, 0.0)");

      ctx.beginPath();
      ctx.moveTo(coords[0].x, height - padding);
      coords.forEach(pt => ctx.lineTo(pt.x, pt.y));
      ctx.lineTo(coords[coords.length - 1].x, height - padding);
      ctx.closePath();
      ctx.fillStyle = gradient;
      ctx.fill();

      // Draw Main Line
      ctx.beginPath();
      ctx.strokeStyle = "#f59e0b";
      ctx.lineWidth = 3;
      ctx.lineJoin = "round";
      ctx.lineCap = "round";
      coords.forEach((pt, i) => {
        if (i === 0) ctx.moveTo(pt.x, pt.y);
        else ctx.lineTo(pt.x, pt.y);
      });
      ctx.stroke();

      // Draw Glowing Dots & Values
      coords.forEach((pt, i) => {
        ctx.beginPath();
        ctx.arc(pt.x, pt.y, 4.5, 0, Math.PI * 2);
        ctx.fillStyle = "#fbbf24";
        ctx.fill();
        ctx.strokeStyle = "#020617";
        ctx.lineWidth = 2;
        ctx.stroke();

        // Value text over point
        ctx.fillStyle = "#f1f5f9";
        ctx.font = "bold 9px Chakra Petch, monospace";
        ctx.fillText(pt.val, pt.x - 10, pt.y - 8);
      });
    }

